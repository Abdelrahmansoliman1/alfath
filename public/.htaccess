# Apache settings for the static export (GoDaddy hosting)

Options -Indexes
DirectoryIndex index.html

# Use the site's own "Page Not Found" page
ErrorDocument 404 /404.html

# Long cache for hashed build files and media; HTML always revalidates
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|jpg|jpeg|png|svg|webp|mp4|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
